# --- Generate secrets (from Attendee image / repo) ---
# python init_env.py
# Or:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DJANGO_SECRET_KEY=replace-with-init_env-or-get_random_secret_key
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-key-from-init_env

# Production settings module (also set in compose)
DJANGO_SETTINGS_MODULE=attendee.settings.production

# Public hostname only (no scheme). Must match Coolify domain.
# Example: attendee.hiinterns.com
SITE_DOMAIN=attendee.example.com
ALLOWED_HOSTS=attendee.example.com
# Comma-separated origins WITH scheme (required for admin/signup CSRF)
CSRF_TRUSTED_ORIGINS=https://attendee.example.com

# Behind Coolify HTTPS proxy (default true in production.py)
DJANGO_SSL_REQUIRE=true

# Internal Postgres (compose service name = postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=attendee_production
POSTGRES_USER=attendee
POSTGRES_PASSWORD=replace-with-strong-password
# false for compose-internal Postgres; true for managed SSL DBs
POSTGRES_SSL_REQUIRE=false

# Internal Redis
REDIS_URL=redis://redis:6379/0

# S3-compatible recording storage (required). AWS S3, Cloudflare R2, or MinIO.
# App reads AWS_RECORDING_STORAGE_BUCKET_NAME (not AWS_STORAGE_BUCKET_NAME).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_RECORDING_STORAGE_BUCKET_NAME=
AWS_DEFAULT_REGION=us-east-1
# R2/MinIO only — leave empty for real AWS S3
# AWS_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# Chrome in Docker
ENABLE_CHROME_SANDBOX=false

# true = confirmation links go to container logs (no SMTP). Set false + EMAIL_* for real mail.
DISABLE_EMAIL=true
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@example.com
